# Copy to .env and fill in. `.env` is gitignored; this file is not, and holds no
# secrets. Compose reads it for variable substitution, and the `environment:`
# list in docker-compose.yml forwards a variable from it into the agent container
# only when it is set -- so an empty line here means the capability is off, not
# broken.
#
#   cp .env.example .env

# --- LLM provider for the agent ----------------------------------------------
# Any one of these is enough; Pi picks a model with /model. Unset all of them and
# run /login inside the container instead.
OPENROUTER_API_KEY=

# --- Long-term memory ---------------------------------------------------------
# The self-hosted Supermemory engine reads and writes memory at
# http://supermemory:6767, on the compose network only. Nothing below is a URL:
# the endpoint is fixed at the service name.
#
# The bearer token, printed once by the engine's first boot. Get it with:
#
#   docker compose run --rm supermemory
#
# then paste the `api key` line here. It is the only Supermemory value the agent
# container needs, and it stays useful across restarts because the engine's auth
# secret lives in its volume.
SUPERMEMORY_API_KEY=

# The model the engine uses for summaries, contextual chunking and memory
# extraction. Not the agent's model. This one is an OpenRouter slug, because the
# engine reaches OpenRouter through its OpenAI-compatible interface
# (OPENAI_BASE_URL in docker-compose.yml).
#
# Extraction quality scales with this, and so does your bill -- every ingested
# document is a call. A small model is fine for conversational memory; repo
# documentation wants something stronger.
SUPERMEMORY_MODEL=thinkingmachines/inkling-small:free

# --- Memory engine internals, all optional -------------------------------------
# Embeddings default to a local model (Xenova/bge-base-en-v1.5, 768d) that needs
# no key and stays on the machine. To move them, set all three together: the
# dimension is locked to whatever the stored vectors already are, so changing it
# against an existing volume corrupts recall and needs a fresh one.
#
# SUPERMEMORY_EMBEDDING_PROVIDER=openai
# SUPERMEMORY_EMBEDDING_MODEL=text-embedding-3-small
# SUPERMEMORY_EMBEDDING_DIMENSIONS=1536
#
# Memory the ingestion queue may use above the engine's boot baseline, and how
# many documents it processes at once. Defaults are 1gb and 2, which suit a
# laptop; raise both for a bulk import, lower them on a small machine.
#
# SUPERMEMORY_EMBEDDING_RAM_LIMIT=1gb
# SUPERMEMORY_INGEST_CONCURRENCY=2
    {
      "id": "claim_41afdc95a7c04ded8e4ec36770d5a0bd",
      "statement": "Every memory request needs Authorization: Bearer $SUPERMEMORY_API_KEY, and an empty value means memory is not configured on this machine, which the agent must treat as a condition to carry on rather than report as an error.",

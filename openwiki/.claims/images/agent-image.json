    {
      "id": "claim_000254a725094ddc86f7f7300f9e9727",
      "statement": "npm's pi entry is a symlink that COPY would resolve if given as its own source, so the build stage stages it into /out/bin and the runtime stage copies that directory, because cli.js locates the rest of the installation relative to its own path.",
      "evidence": [
        {
          "resource": "repo://Dockerfile#L22-L29",
          "version": "repo-lines-v1:sha256:510080883c1b64f35ddd2276864603fc39ee3ac62683d90d70354e60744ba73c:"

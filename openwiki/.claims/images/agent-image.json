  "claims": [
    {
      "id": "claim_6831c56393604a3da36537a2789c76ae",
      "statement": "The agent image carries the agent and a small tool set but not the agent's configuration, because agent/ is bind-mounted at run time and excluded from the build context.",
      "evidence": [
        {
          "resource": "repo://.dockerignore#L1-L6",
          "version": "repo-lines-v1:sha256:016be1331594a283fdbc54435a7a29810e005783e079e31237619225c7fb25d2:"
        },
        {
          "resource": "repo://Dockerfile#L1-L9",
          "version": "repo-lines-v1:sha256:20afb89e401783f1910f02b5398e6c4d15243b72ba1b4cff77e7baf73f708fe6:"
        }
      ]
    },
    {
      "id": "claim_40bd1cc29cd3444fbd4f7f9edb80f25a",
      "statement": "The agent image is built in two node:24-bookworm-slim stages so that build-only work — the npm cache, the prune helper and the shrinkwrapped cross-platform binaries — never reaches the runtime layer.",
      "evidence": [
        {
          "resource": "repo://Dockerfile#L11-L29",
          "version": "repo-lines-v1:sha256:52976157ce3a8ffca014e26fdb56cb61a21602a395010f62f603634660611285:"
        },
        {
          "resource": "repo://Dockerfile#L31-L52",
          "version": "repo-lines-v1:sha256:9a39778cbd23f340b140fee342c99bfe2188006b7b4c19998d9c92f3299b65cb:"
        }
      ]
    },
    {
      "id": "claim_4377ca3758084ac1a8c459487ce44953",
      "statement": "The Pi version is pinned once, as ARG PI_VERSION=1.0.2, and installed with npm install -g --ignore-scripts; no image name or other file carries a version, and no latest tag is used.",
      "evidence": [
        {
          "resource": "repo://Dockerfile#L15-L18",
          "version": "repo-lines-v1:sha256:9caf0e8ded3abc58c6f2a9a2ac6f00f87ae3b16573848f80ebb3389275f52081:"
        }
      ]
    },
    {
      "id": "claim_25dd1e9a569d4016821045b8453099f2",
      "statement": "The runtime tool set is installed in one apt-get layer — bash, ca-certificates, curl, fd-find, file, git, jq, less, make, openssh-client, procps, python3 and ripgrep — with the apt lists removed afterwards.",
      "evidence": [
        {
          "resource": "repo://Dockerfile#L37-L43",
          "version": "repo-lines-v1:sha256:d02dd4448886b25b2de526dbd3cbfc89c916ea6e915ed358ce43e0836895616c:"
        }
      ]
    },
    {
      "id": "claim_6eca8e16329a43a5b267b30e32694ad1",
      "statement": "Because Debian installs the file finder as fdfind, the image symlinks /usr/local/bin/fd to it so the agent gets the name it expects.",
      "evidence": [
        {
          "resource": "repo://Dockerfile#L35-L43",
          "version": "repo-lines-v1:sha256:2e114dcfb415367440cf04b44583968e98697dabbb92f7c76a239444d8dc34df:"
        }
      ]
    },
    {
      "id": "claim_03ff83757e08410086b1b1f4cf283bbb",
      "statement": "The image deliberately ships no compiler toolchain while keeping make for driving build recipes, and agent/AGENTS.md states the absence so the agent does not assume a compiler exists.",
      "evidence": [
        {
          "resource": "repo://Dockerfile#L37-L43",
          "version": "repo-lines-v1:sha256:d02dd4448886b25b2de526dbd3cbfc89c916ea6e915ed358ce43e0836895616c:"

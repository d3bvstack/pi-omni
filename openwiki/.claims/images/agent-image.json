        }
      ]
    },
    {
      "id": "claim_4dea9a61181a49129b59e1dda733015b",
      "statement": "The runtime stage asserts test -x /usr/local/bin/pi immediately after copying, so a package that moves its entry point fails the build instead of the first run.",
      "evidence": [
        {
          "resource": "repo://Dockerfile#L45-L52",

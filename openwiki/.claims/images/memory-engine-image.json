      ]
    },
    {
      "id": "claim_aa097f6da35f4134a481d8279691cd6a",
      "statement": "The server release artefact is built from a non-public codebase, so the image pins ARG SUPERMEMORY_VERSION=0.0.8 and states that checksum verification catches a truncated, corrupted or CDN-swapped download but does not make an unreviewable binary reviewable.",
      "evidence": [

    },
    {
      "id": "claim_52689f4bf41c4df4aff12f6e3b7bb4d3",
      "statement": "The build reads the platform sha256 out of the release manifest, requires it to be exactly 64 hex characters, and verifies the downloaded asset with sha256sum -c before chmod 0755 makes it executable.",

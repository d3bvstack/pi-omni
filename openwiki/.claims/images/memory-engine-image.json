    {
      "id": "claim_c1d388da2bda4ed9ad4ff44a80a7b6e7",
      "statement": "The release platform is derived from dpkg --print-architecture rather than buildx TARGETARCH, so a plain docker build without BuildKit resolves the platform the runtime will execute on, and an unsupported architecture fails the build.",

        }
      ]
    },
    {
      "id": "claim_38dda2bad4394b3a8e5e05e66a72bac8",
      "statement": "The uid decision is taken from the daemon's own SecurityOptions: rootless Docker gets no --user because container root already maps to the host user, rootful Docker gets --user $(id -u):$(id -g) so files written into the workspace belong to the host user.",
      "evidence": [
        {
          "resource": "repo://bin/pi#L89-L97",
          "version": "repo-lines-v1:sha256:202c981e13cb758e24ea339ea5b48bbaea2218df5fe596f26e47a68ce272cdc1:"
        }
      ]
    },
    {
      "id": "claim_e384a5e445d14c27a620f60f33275b4a",
      "statement": "Images are built when --build was passed or when either image is missing according to docker image inspect, and both services are built together so a fresh clone cannot fail on depends_on before the agent gets a session.",
      "evidence": [
        {
          "resource": "repo://bin/pi#L100-L107",
          "version": "repo-lines-v1:sha256:9eb23303d47a8b590fcb4dbe5acf64d1e00333ee8aa666790b3a2a7df6978194:"
        }
      ]
    },
    {
      "id": "claim_36945c2b92b94988924d981e973fe1d4",
      "statement": "The launcher passes -T when stdin or stdout is not a terminal, because Compose run would otherwise refuse a piped stdin.",

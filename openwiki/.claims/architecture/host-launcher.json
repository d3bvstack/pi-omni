        }
      ]
    },
    {
      "id": "claim_0ff64df489244819a4d5063703051f37",
      "statement": "The launcher accepts -h/--help, -V/--version, --build, --shell, a -- separator and at most one positional directory, and --version prints the repository root and both image names so a user can distinguish it from a native pi install.",
      "evidence": [
        {
          "resource": "repo://bin/pi#L37-L76",
          "version": "repo-lines-v1:sha256:49ed4e3020162b015f84150aa5dcb85c0c64e5b519a839257adaa378a8067b24:"
        }
      ]
    },
    {
      "id": "claim_eebcfa69e6524926988d462763ee0ec4",
      "statement": "An unknown option, a second positional argument and a target that is not a directory all exit 2, while an unreachable Docker daemon exits 1, separating usage errors from environment failures.",
      "evidence": [
        {
          "resource": "repo://bin/pi#L60-L74",
          "version": "repo-lines-v1:sha256:5acf7032df2173415b71e88579cac04012298cf9282098bd06239c579e51c850:"

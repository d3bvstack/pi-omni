    {
      "id": "claim_813837658fbf4a5a8afcb461926ed889",
      "statement": "A run is four staged handoffs — host launcher decides, image supplies the runtime, Compose wires mounts and environment, entrypoint prepares — in which the launcher exports only PROJECT_DIR, AGENT_DIR, PI_IMAGE and SUPERMEMORY_IMAGE before execing docker compose run --rm with the mode and the agent's arguments.",
      "evidence": [
        {
          "resource": "repo://bin/pi#L116-L124",
          "version": "repo-lines-v1:sha256:d99ff30cb0ee5bf685908728a7e42cb8092994377acd359b99338aa0ac9ecce4:"
        },
        {

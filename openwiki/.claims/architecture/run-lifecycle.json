          "version": "repo-lines-v1:sha256:3c035bb3250b2a3de022b2befca9453338a757809e8c6c7035b4613b200fdf87:"
        }
      ]
    },
    {
      "id": "claim_701b00bc3aad4224808b4071ec73174c",
      "statement": "The launcher builds the images only when --build was passed or either image is missing, and builds both services together in that case so a fresh clone cannot fail on depends_on before the agent gets a session.",
      "evidence": [
        {
          "resource": "repo://bin/pi#L100-L107",
          "version": "repo-lines-v1:sha256:9eb23303d47a8b590fcb4dbe5acf64d1e00333ee8aa666790b3a2a7df6978194:"
        }
